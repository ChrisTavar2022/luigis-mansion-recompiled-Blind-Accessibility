+                                    cmp_arg(stage.colorPass.b, stage.alphaPass.b),
                                     alpha_arg(stage.alphaPass.c), alpha_arg_reg(stage.alphaPass.d, idx, config, stage));
       fragmentFn += fmt::format("\n    {0}.a = {1};", outReg, op);
