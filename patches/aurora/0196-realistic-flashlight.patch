+// 0196: a 3x4 matrix as 12 floats (row-major, the layout Aurora stores XF matrices in).
+using M34 = std::array<float, 12>;
+M34 m34(const Mat3x4<float>& m) noexcept {
+  M34 r;
+  std::memcpy(r.data(), &m, sizeof(r));
