+// a x [b; 0 0 0 1]
+M34 m34_mul(const M34& a, const M34& b) noexcept {
+  M34 r{};
+  for (int i = 0; i < 3; ++i) {
+    for (int j = 0; j < 4; ++j) {
+      float v = a[i * 4 + 0] * b[0 * 4 + j] + a[i * 4 + 1] * b[1 * 4 + j] + a[i * 4 + 2] * b[2 * 4 + j];
+      if (j == 3) {
+        v += a[i * 4 + 3];
+      }
+      r[i * 4 + j] = v;
+    }
+  }
