+  if (!(std::abs(det) > 1e-12f) || !std::isfinite(det)) {
+    return false;
+  }
+  const float s = 1.f / det;
+  const float r[9] = {A * s, -(b * i - c * h) * s, (b * f - c * e) * s, B * s, (a * i - c * g) * s, -(a * f - c * d) * s,
+                      C * s, -(a * h - b * g) * s, (a * e - b * d) * s};
+  for (int k = 0; k < 3; ++k) {
+    out[k * 4 + 0] = r[k * 3 + 0];
+    out[k * 4 + 1] = r[k * 3 + 1];
+    out[k * 4 + 2] = r[k * 3 + 2];
+    out[k * 4 + 3] = -(r[k * 3 + 0] * m[3] + r[k * 3 + 1] * m[7] + r[k * 3 + 2] * m[11]);
