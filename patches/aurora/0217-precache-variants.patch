+        const auto& st = c.shaderConfig.tevStages[i];
+        textured = textured || st.texMapId != GX_TEXMAP_NULL;
+        want = want || (st.alphaOp.op == GX_TEV_COMP_GR16_GT && st.colorPass.b == GX_CC_TEXC);
+      }
+      if (textured && want) {
