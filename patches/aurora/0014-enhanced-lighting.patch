+    let radius = max(enh_ld(b + 3u), 1.0);
+    let dist2 = dot(d, d);
+    if (dist2 >= radius * radius) { continue; }
+    let l = d * inverseSqrt(max(dist2, 1e-6));
+    let x2 = dist2 / (radius * radius);
+    let w = (1.0 - x2) * (1.0 - x2);
+    let fall = w / (1.0 + 8.0 * x2);
+    var ndl = dot(n, l);
+    ndl = select(max(ndl, 0.0), ndl * 0.5 + 0.5, ghost);
+    let col = vec3f(enh_ld(b + 4u), enh_ld(b + 5u), enh_ld(b + 6u)) * enh_ld(b + 7u);
