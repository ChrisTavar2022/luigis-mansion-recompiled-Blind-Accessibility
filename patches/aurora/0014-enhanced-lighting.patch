+fn enh_ld(i: u32) -> f32 { return bitcast<f32>(abuf[i]); }
+// Extra point lights (aurora/lights.h), 12 words each in the storage buffer:
+// pos xyz, radius, color rgb, intensity, flags, id, 0, 0.
+fn enh_extra_lights(p: vec3f, n: vec3f, ghost: bool) -> vec3f {
+  var sum = vec3f(0.0);
+  let cnt = min(ubuf.enh_light_count, 16u);
+  let v = normalize(-p);
+  for (var i = 0u; i < cnt; i++) {
