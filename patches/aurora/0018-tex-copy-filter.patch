 fn sample_efb(uv: vec2f) -> vec4f {
-    let c = textureSample(src, src_samp, uv);
+    var c = textureSample(src, src_samp, uv);
+    // Vertical copy filter (GXSetCopyFilter): weighted sum (taps out of 64) of the EFB line
+    // above, this line and the line below, saturating at 1, before the format conversion; RGB
+    // only (alpha is copied from this line). Uniform control flow:
+    // the neighbours are sampled unconditionally.
+    let above = textureSample(src, src_samp, uv - vec2f(0.0, ubuf.lineStep));
+    let below = textureSample(src, src_samp, uv + vec2f(0.0, ubuf.lineStep));
+    if (ubuf.filterTaps != 0u) {
+        let wa = f32(ubuf.filterTaps & 0xffu);
+        let wc = f32((ubuf.filterTaps >> 8u) & 0xffu);
+        let wb = f32((ubuf.filterTaps >> 16u) & 0xffu);
+        c = vec4f(min((above.rgb * wa + c.rgb * wc + below.rgb * wb) / 64.0, vec3f(1.0)), c.a);
+    }
     return vec4f(c.rgb, select(c.a, 1.0, ubuf.opaqueAlpha != 0u));
 }
 
