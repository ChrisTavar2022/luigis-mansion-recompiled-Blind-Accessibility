+// Copy filter taps (0x53: taps 0-3, 0x54: taps 4-6; 6 bits each).
+void bp_copy_filter(u8 reg, u32 value) noexcept {
+  auto& t = g_gxState.copyVFilter;
+  if (reg == 0x53) {
+    for (u32 i = 0; i < 4; ++i) {
+      t[i] = static_cast<u8>(reg_get(value, 6, i * 6));
+    }
+  } else {
+    for (u32 i = 0; i < 3; ++i) {
+      t[4 + i] = static_cast<u8>(reg_get(value, 6, i * 6));
+    }
+  }
+}
