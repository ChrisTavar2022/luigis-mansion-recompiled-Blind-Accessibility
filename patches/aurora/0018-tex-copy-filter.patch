+void GXSetCopyFilter(GXBool aa, u8 sample_pattern[12][2], GXBool vf, u8 vfilter[7]) {
+  (void)aa;
+  (void)sample_pattern;
+  // Vertical copy filter (BP 0x53/0x54, 6-bit taps). With vf off the hardware gets the
+  // pass-through taps {0, 0, 21, 22, 21, 0, 0}. Aurora applies it to color texture copies
+  // (GXCopyTex, GX_AURORA_ACCURACY_COPY_FILTER); the display copy is the host's business.
+  static constexpr u8 kPassThrough[7] = {0, 0, 21, 22, 21, 0, 0};
+  const u8* taps = vf && vfilter != nullptr ? vfilter : kPassThrough;
+  u32 reg0 = 0;
+  u32 reg1 = 0;
+  SET_REG_FIELD(0, reg0, 6, 0, taps[0] & 0x3F);
+  SET_REG_FIELD(0, reg0, 6, 6, taps[1] & 0x3F);
+  SET_REG_FIELD(0, reg0, 6, 12, taps[2] & 0x3F);
+  SET_REG_FIELD(0, reg0, 6, 18, taps[3] & 0x3F);
+  SET_REG_FIELD(0, reg0, 8, 24, 0x53);
+  SET_REG_FIELD(0, reg1, 6, 0, taps[4] & 0x3F);
+  SET_REG_FIELD(0, reg1, 6, 6, taps[5] & 0x3F);
+  SET_REG_FIELD(0, reg1, 6, 12, taps[6] & 0x3F);
+  SET_REG_FIELD(0, reg1, 8, 24, 0x54);
+  GX_WRITE_RAS_REG(reg0);
+  GX_WRITE_RAS_REG(reg1);
+  __gx->bpSent = 1;
+}
 
