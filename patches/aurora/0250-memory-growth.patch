+  explicit TextureMemCounter(uint64_t b) noexcept : bytes(b) { add(); }
+  TextureMemCounter(const TextureMemCounter& o) noexcept : bytes(o.bytes) { add(); }
+  TextureMemCounter& operator=(const TextureMemCounter& o) noexcept {
+    sub();
+    bytes = o.bytes;
+    add();
+    return *this;
+  }
+  ~TextureMemCounter() { sub(); }
+  void add() noexcept {
+    s_count.fetch_add(1, std::memory_order_relaxed);
+    s_bytes.fetch_add(bytes, std::memory_order_relaxed);
+  }
+  void sub() noexcept {
+    s_count.fetch_sub(1, std::memory_order_relaxed);
+    s_bytes.fetch_sub(bytes, std::memory_order_relaxed);
+  }
