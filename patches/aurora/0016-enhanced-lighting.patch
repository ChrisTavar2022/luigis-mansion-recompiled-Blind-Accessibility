+  return fmt::format(
+      "\n    // Enhanced soft shadow (stage {0})"
+      "\n    let enh_recv{0} = {1};"
+      "\n    let enh_slope{0} = fwidth(enh_recv{0}) / max(length(fwidth(tex{2}_uv * vec2f(textureDimensions(tex{3})))), 1e-3);"
+      "\n    var enh_sf{0} = select(0.0, 1.0, {4});"
