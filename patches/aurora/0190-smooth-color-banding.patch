     return f32(x | (x >> n) | (x >> (2u * n))) / 255.0;
 }
+
+// The n-bit level k widened like bits8: x | x >> n | x >> 2n with x = k << (8 - n).
+fn widen8(k: f32, lev: f32, step: f32) -> f32 {
+    let x = k * step;
+    return x + floor(x / lev) + floor(x / (lev * lev));
+}
+
+// 0190 (GX_AURORA_ACCURACY_EFB_SMOOTH, quantize == 2): the average of bits8 over a smooth input
+// instead of its steps. The EFB holds 6-bit values, so keeping n bits drops 6 - n of them, on
+// average 2 * (2^(6 - n) - 1) of 255 (2 for 5 bits, 6 for 4, 0 for 6): the ramp through the widened
+// n-bit levels, shifted by that, keeps the copy's brightness and tint without its bands.
+fn smooth8(v: f32, n: u32) -> f32 {
+    let lev = f32(1u << n);
+    let step = 256.0 / lev;
+    let t = (clamp(v, 0.0, 1.0) * 255.0 - 2.0 * (64.0 / lev - 1.0)) / step;
+    let k = clamp(floor(t), 0.0, lev - 1.0);
+    let k1 = min(k + 1.0, lev - 1.0);
+    return mix(widen8(k, lev, step), widen8(k1, lev, step), clamp(t - k, 0.0, 1.0)) / 255.0;
+}
