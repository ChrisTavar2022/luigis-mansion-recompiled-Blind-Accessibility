+std::string group_of(const char* name) {
+  std::string s{name};
+  while (!s.empty() && (std::isdigit(static_cast<unsigned char>(s.back())) != 0)) {
+    s.pop_back();
+  }
+  while (!s.empty() && s.back() == ' ') {
+    s.pop_back();
+  }
+  return s;
+}
+
+void text_flush(int64_t now) {
+  const double secs = double(now - g_windowStartNs) * 1e-9;
+  if (g_frames == 0 || secs <= 0) {
+    return;
+  }
+  const double perFrame = 1e-6 / double(g_frames);
+  std::vector<std::pair<double, std::string>> rows;
+  for (const auto& [k, v] : g_byGroup) {
+    rows.emplace_back(v.ns * perFrame, fmt::format("{:<34} {:7.3f} ms  x{:.1f}", k, v.ns * perFrame,
+                                                   double(v.count) / double(g_frames)));
+  }
+  std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+  std::string out = fmt::format("GPU profile: {} frames in {:.1f} s ({:.1f} fps), busy {:.3f} ms/frame "
+                                "(= {:.0f}% of wall time), span {:.3f} ms/frame",
+                                g_frames, secs, double(g_frames) / secs, g_busyNs * perFrame,
+                                100.0 * g_busyNs * 1e-9 / secs, g_spanNs * perFrame);
+  for (const auto& r : rows) {
+    out += "\n  ";
+    out += r.second;
+  }
+  std::vector<std::pair<double, std::string>> labels;
+  for (const auto& [k, v] : g_byLabel) {
+    labels.emplace_back(v.ns * perFrame, k);
+  }
+  std::sort(labels.begin(), labels.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+  out += "\n  top passes:";
+  for (size_t i = 0; i < labels.size() && i < 12; ++i) {
+    out += fmt::format("  {} {:.3f}", labels[i].second, labels[i].first);
+  }
+  Log.info("{}", out);
+  g_byGroup.clear();
+  g_byLabel.clear();
+  g_busyNs = 0;
+  g_spanNs = 0;
+  g_frames = 0;
+  g_windowStartNs = now;
+}
+
+void text_frame(const Slot& slot, const uint64_t* ts, uint64_t frameBegin, uint64_t frameEnd) {
+  const int64_t now = now_ns();
+  if (g_windowStartNs == 0) {
+    g_windowStartNs = now;
+    return;
+  }
+  // Pair begins with ends (events mirror encode order, properly nested).
+  std::vector<const Event*> stack;
+  uint32_t depth = 0;
+  for (const auto& event : slot.events) {
+    if (event.kind == EventKind::End) {
+      if (stack.empty()) {
+        continue;
+      }
+      const Event* b = stack.back();
+      stack.pop_back();
+      --depth;
+      const uint64_t t0 = ts[b->query];
+      const uint64_t t1 = ts[event.query];
+      if (t0 == 0 || t1 <= t0 || t1 - t0 > SaneFrameGapNs) {
+        continue;
+      }
+      const double d = double(t1 - t0);
+      auto& g = g_byGroup[group_of(b->name)];
+      g.ns += d;
+      ++g.count;
+      auto& l = g_byLabel[b->name];
+      l.ns += d;
+      ++l.count;
+      if (depth == 0) {
+        g_busyNs += d;
+      }
+    } else {
+      stack.push_back(&event);
+      ++depth;
+    }
+  }
+  if (frameEnd > frameBegin && frameEnd - frameBegin < SaneFrameGapNs) {
+    g_spanNs += double(frameEnd - frameBegin);
+  }
+  ++g_frames;
+  if (double(now - g_windowStartNs) * 1e-9 >= text_interval_s()) {
+    text_flush(now);
+  }
+}
