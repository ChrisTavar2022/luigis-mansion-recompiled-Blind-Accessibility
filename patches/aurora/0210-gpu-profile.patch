+// ---- 0210: text profile (AURORA_GPU_PROFILE) ----
+double text_interval_s() {
+  static const double s = [] {
+    const char* env = std::getenv("AURORA_GPU_PROFILE");
+    if (env == nullptr) {
+      return 0.0;
+    }
+    const double v = std::atof(env);
