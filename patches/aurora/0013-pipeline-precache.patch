+uint32_t aurora_pipeline_cache_seed(const char* path) {
+  const auto file = read_file(path);
+  if (file.size() < PrecacheHeaderSize) {
+    Log.info("No pipeline precache list at '{}'", path);
+    return 0;
+  }
+  const uint8_t* p = file.data();
+  const uint8_t* end = p + file.size();
+  uint32_t magic = 0, format = 0, flags = 0, count = 0;
+  uint64_t rawSize = 0;
+  read_le(p, end, magic);
+  read_le(p, end, format);
+  read_le(p, end, flags);
+  read_le(p, end, count);
+  read_le(p, end, rawSize);
+  if (magic != PrecacheMagic || format != PrecacheFormat || rawSize > (1ull << 31)) {
+    Log.warn("Pipeline precache list '{}' has an unknown format", path);
+    return 0;
+  }
+  std::vector<uint8_t> payload;
+  if ((flags & PrecacheFlagZstd) != 0) {
+#if defined(AURORA_CACHE_USE_ZSTD)
+    payload.resize(static_cast<size_t>(rawSize));
+    const size_t ret = ZSTD_decompress(payload.data(), payload.size(), p, static_cast<size_t>(end - p));
+    if (ZSTD_isError(ret) || ret != rawSize) {
+      Log.warn("Pipeline precache list '{}' failed to decompress", path);
+      return 0;
+    }
+#else
+    Log.warn("Pipeline precache list '{}' is compressed but zstd support is disabled", path);
+    return 0;
+#endif
+  } else {
+    payload.assign(p, end);
+  }
+  p = payload.data();
+  end = p + payload.size();
+  uint32_t accepted = 0, skipped = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    uint8_t type = 0;
+    uint32_t version = 0, size = 0, firstFrame = 0;
+    if (!read_le(p, end, type) || !read_le(p, end, version) || !read_le(p, end, size) ||
+        !read_le(p, end, firstFrame) || static_cast<size_t>(end - p) < size) {
+      Log.warn("Pipeline precache list '{}' is truncated", path);
+      break;
+    }
+    bool ok = false;
+    switch (static_cast<ShaderType>(type)) {
+    case ShaderType::Clear:
+      ok = seed_row<clear::PipelineConfig>(ShaderType::Clear, version, p, size, firstFrame);
+      break;
+    case ShaderType::GX:
+      ok = seed_row<aurora::gx::PipelineConfig>(ShaderType::GX, version, p, size, firstFrame);
+      break;
+    default:
+      break;
+    }
+    p += size;
+    ok ? ++accepted : ++skipped;
+  }
+  g_seeded += accepted;
+  Log.info("Pipeline precache list '{}': {} configs ({} for another Aurora version skipped)", path, accepted,
+           skipped);
+  return accepted;
+}
