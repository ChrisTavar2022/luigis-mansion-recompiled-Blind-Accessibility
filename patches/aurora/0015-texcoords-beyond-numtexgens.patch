diff --git a/include/dolphin/gx/GXAurora.h b/include/dolphin/gx/GXAurora.h
index 38dc31d..3d370ff 100644
--- a/include/dolphin/gx/GXAurora.h
+++ b/include/dolphin/gx/GXAurora.h
@@ -124,6 +124,16 @@ extern "C" {
 void GXSetAuroraAccuracy(u32 flags);
 u32 GXGetAuroraAccuracy();
 
+/**
+ * What a TEV or indirect stage reads from a texture coordinate at or beyond GXSetNumTexGens:
+ * 0 = (0, 0); 1 (default) = the coordinate its texgen registers describe, as if it were counted;
+ * 2 = texture coordinate 0.
+ */
+#define GX_AURORA_TEXGEN_BEYOND_ZERO 0
+#define GX_AURORA_TEXGEN_BEYOND_GENERATE 1
+#define GX_AURORA_TEXGEN_BEYOND_TEXCOORD0 2
+void GXSetAuroraTexGenBeyondCount(u32 mode);
+
 /*
  * Debug marker stuff
  */
diff --git a/lib/dolphin/gx/GXAurora.cpp b/lib/dolphin/gx/GXAurora.cpp
index b2b1312..dff3642 100644
--- a/lib/dolphin/gx/GXAurora.cpp
+++ b/lib/dolphin/gx/GXAurora.cpp
@@ -67,6 +67,8 @@ void GXSetAuroraAccuracy(u32 flags) { aurora::gx::g_accuracyFlags.store(flags, s
 
 u32 GXGetAuroraAccuracy() { return aurora::gx::g_accuracyFlags.load(std::memory_order_relaxed); }
 
+void GXSetAuroraTexGenBeyondCount(u32 mode) { aurora::gx::g_texGenBeyondCount.store(mode, std::memory_order_relaxed); }
+
 void GXSetViewportRender(f32 left, f32 top, f32 wd, f32 ht, f32 nearz, f32 farz) {
