+// The top n bits of an 8-bit channel, expanded back to 8 bits by bit replication (as the texture
+// unit decodes RGB565/RGB5A3 texels).
+fn bits8(v: f32, n: u32) -> f32 {
+    let x = (u32(round(clamp(v, 0.0, 1.0) * 255.0)) >> (8u - n)) << (8u - n);
+    return f32(x | (x >> n) | (x >> (2u * n))) / 255.0;
+}
